        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1512" TIME_SLOT_REF1="ts378" TIME_SLOT_REF2="ts379">
                <ANNOTATION_VALUE>We'll pass here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1513" TIME_SLOT_REF1="ts380" TIME_SLOT_REF2="ts381">
                <ANNOTATION_VALUE>Well, if you aim well, we'll come.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1514" TIME_SLOT_REF1="ts382" TIME_SLOT_REF2="ts383">
                <ANNOTATION_VALUE>Way to go!</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1515" TIME_SLOT_REF1="ts385" TIME_SLOT_REF2="ts387">
                <ANNOTATION_VALUE>Now it will be a little worse.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1516" TIME_SLOT_REF1="ts396" TIME_SLOT_REF2="ts397">
                <ANNOTATION_VALUE>Here you will need a lot...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1517" TIME_SLOT_REF1="ts398" TIME_SLOT_REF2="ts399">
                <ANNOTATION_VALUE>I don't think we'll get through here.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1518" TIME_SLOT_REF1="ts402" TIME_SLOT_REF2="ts405">
                <ANNOTATION_VALUE>It worked.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1519" TIME_SLOT_REF1="ts421" TIME_SLOT_REF2="ts431">
                <ANNOTATION_VALUE>No no no A little bit of you, a little bit of you, a little bit of me Well, you a little bit to the left.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1520" TIME_SLOT_REF1="ts434" TIME_SLOT_REF2="ts441">
                <ANNOTATION_VALUE>Careful, careful.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1521" TIME_SLOT_REF1="ts442" TIME_SLOT_REF2="ts443">
                <ANNOTATION_VALUE>A little bit of you.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1522" TIME_SLOT_REF1="ts444" TIME_SLOT_REF2="ts450">
                <ANNOTATION_VALUE>Okay, now you.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1523" TIME_SLOT_REF1="ts455" TIME_SLOT_REF2="ts457">
                <ANNOTATION_VALUE>No.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1524" TIME_SLOT_REF1="ts458" TIME_SLOT_REF2="ts459">
                <ANNOTATION_VALUE>Come on in.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
